# انسخ هذا الملف إلى .env وعبّئ القيم. لا ترفع .env إلى GitHub.
# extractive (الافتراضي): يقتبس المقاطع حرفيًا بلا نموذج.  model: يصوغ الجواب نموذجٌ من المقاطع فقط.
LLM_PROVIDER=extractive
# النموذج الأساسي (القرار D1)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
# البديل الاحتياطي (اختياري، الطبقة المدفوعة)
GEMINI_API_KEY=
GEMINI_MODEL=
# مسار ملف المقاطع. الافتراضي: data/synthetic_corpus.json (بيانات تجريبية مصطنعة)
MUHAWIR_CORPUS=
